APP_NAME="Astro Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (MySQL) ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=astrologer
DB_USERNAME=root
DB_PASSWORD=

# ── Cache / Session / Queue ──────────────────────────────────────
# Use "database" for local dev (no Redis needed on XAMPP).
# Switch to "redis" in production (Docker / AWS).
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ── Redis (only needed when CACHE_STORE=redis) ───────────────────
# Use predis (pure PHP) — does NOT require the php_redis XAMPP extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@astro.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum ──────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1
SESSION_DOMAIN=localhost
